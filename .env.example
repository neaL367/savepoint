# Savepoint — server-only secrets (never use a NEXT_PUBLIC_ prefix here)
# IGDB authenticates through Twitch: create an app at https://dev.twitch.tv/console
# to get a Client ID, then generate a Client Secret for it.
# IGDB enforces roughly 4 requests/second; the app throws instead of
# retrying on HTTP 429. Confirm IGDB's current terms before commercial use.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
